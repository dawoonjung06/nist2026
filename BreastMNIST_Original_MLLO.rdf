     -->

    


    <!-- https://github.com/example/breastmnist-mllo#BreastBatchSize_32 -->

    <rdf:Description rdf:about="https://github.com/example/breastmnist-mllo#BreastBatchSize_32">
        <construct:hasConfigurationSettingValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">32</construct:hasConfigurationSettingValue>
    </rdf:Description>
    


    <!-- https://github.com/example/breastmnist-mllo#BreastEpochNumber_11 -->

    <rdf:Description rdf:about="https://github.com/example/breastmnist-mllo#BreastEpochNumber_11">
        <construct:hasConfigurationSettingValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</construct:hasConfigurationSettingValue>
    </rdf:Description>
    


    <!-- https://github.com/example/breastmnist-mllo#BreastResNet18_Pretrained -->

    <rdf:Description rdf:about="https://github.com/example/breastmnist-mllo#BreastResNet18_Pretrained">
        <construct:isComposedOf rdf:resource="https://github.com/example/breastmnist-mllo#BreastFCLayer_Binary"/>
    </rdf:Description>
    


    <!-- https://github.com/example/breastmnist-mllo#BreastResNet18_Training -->

    <rdf:Description rdf:about="https://github.com/example/breastmnist-mllo#BreastResNet18_Training">
        <construct:executed rdf:resource="https://github.com/example/breastmnist-mllo#BreastAdamW_Optimizer"/>
        <construct:executed rdf:resource="https://github.com/example/breastmnist-mllo#BreastResNet18_Pretrained"/>
        <construct:hasConfigurationVariable rdf:resource="https://github.com/example/breastmnist-mllo#BreastBatchSize_32"/>
        <construct:hasConfigurationVariable rdf:resource="https://github.com/example/breastmnist-mllo#BreastEpochNumber_11"/>
        <construct:hasDataInput rdf:resource="https://github.com/example/breastmnist-mllo#BreastTrainDataset_Transformed"/>
    </rdf:Description>
    


    <!-- https://github.com/example/breastmnist-mllo#BreastTestAccuracy_0_9103 -->

    <rdf:Description rdf:about="https://github.com/example/breastmnist-mllo#BreastTestAccuracy_0_9103">
        <construct:hasConfigurationSettingValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.9103</construct:hasConfigurationSettingValue>
    </rdf:Description>
    


    <!-- https://github.com/example/breastmnist-mllo#BreastTestEvaluation -->

    <rdf:Description rdf:about="https://github.com/example/breastmnist-mllo#BreastTestEvaluation">
        <construct:executed rdf:resource="https://github.com/example/breastmnist-mllo#BreastResNet18_Pretrained"/>
        <construct:hasDataInput rdf:resource="https://github.com/example/breastmnist-mllo#BreastTestDataset_Transformed"/>
    </rdf:Description>
    


    <!-- https://github.com/example/breastmnist-mllo#BreastTestTransformPipeline -->

    <rdf:Description rdf:about="https://github.com/example/breastmnist-mllo#BreastTestTransformPipeline">
        <construct:hasDataInput rdf:resource="https://github.com/example/breastmnist-mllo#BreastTestDataset"/>
        <construct:hasDataOutput rdf:resource="https://github.com/example/breastmnist-mllo#BreastTestDataset_Transformed"/>
        <construct:isComposedOf rdf:resource="https://github.com/example/breastmnist-mllo#BreastGrayscaleEvalOp"/>
        <construct:isComposedOf rdf:resource="https://github.com/example/breastmnist-mllo#BreastNormalizeEvalOp"/>
        <construct:isComposedOf rdf:resource="https://github.com/example/breastmnist-mllo#BreastToTensorEvalOp"/>
    </rdf:Description>
    


    <!-- https://github.com/example/breastmnist-mllo#BreastTrainTransformPipeline -->

    <rdf:Description rdf:about="https://github.com/example/breastmnist-mllo#BreastTrainTransformPipeline">
        <construct:hasDataInput rdf:resource="https://github.com/example/breastmnist-mllo#BreastTrainDataset"/>
        <construct:hasDataOutput rdf:resource="https://github.com/example/breastmnist-mllo#BreastTrainDataset_Transformed"/>
        <construct:isComposedOf rdf:resource="https://github.com/example/breastmnist-mllo#BreastGrayscaleTo3ChannelOp"/>
        <construct:isComposedOf rdf:resource="https://github.com/example/breastmnist-mllo#BreastNormalizeTrainOp"/>
        <construct:isComposedOf rdf:resource="https://github.com/example/breastmnist-mllo#BreastRandomHorizontalFlipOp"/>
        <construct:isComposedOf rdf:resource="https://github.com/example/breastmnist-mllo#BreastRandomRotation10Op"/>
        <construct:isComposedOf rdf:resource="https://github.com/example/breastmnist-mllo#BreastToTensorTrainOp"/>
    </rdf:Description>
    


    <!-- https://github.com/example/breastmnist-mllo#BreastValTransformPipeline -->

    <rdf:Description rdf:about="https://github.com/example/breastmnist-mllo#BreastValTransformPipeline">
        <construct:hasDataInput rdf:resource="https://github.com/example/breastmnist-mllo#BreastValDataset"/>
        <construct:hasDataOutput rdf:resource="https://github.com/example/breastmnist-mllo#BreastValDataset_Transformed"/>
        <construct:isComposedOf rdf:resource="https://github.com/example/breastmnist-mllo#BreastGrayscaleEvalOp"/>
        <construct:isComposedOf rdf:resource="https://github.com/example/breastmnist-mllo#BreastNormalizeEvalOp"/>
        <construct:isComposedOf rdf:resource="https://github.com/example/breastmnist-mllo#BreastToTensorEvalOp"/>
    </rdf:Description>
    


    <!-- https://github.com/example/breastmnist-mllo#LoadBreastMNISTOperation -->

    <rdf:Description rdf:about="https://github.com/example/breastmnist-mllo#LoadBreastMNISTOperation">
        <construct:hasDataOutput rdf:resource="https://github.com/example/breastmnist-mllo#BreastMNIST224_RawData"/>
        <construct:hasDataOutput rdf:resource="https://github.com/example/breastmnist-mllo#BreastTestDataset"/>
        <construct:hasDataOutput rdf:resource="https://github.com/example/breastmnist-mllo#BreastTrainDataset"/>
        <construct:hasDataOutput rdf:resource="https://github.com/example/breastmnist-mllo#BreastValDataset"/>
    </rdf:Description>
</rdf:RDF>



