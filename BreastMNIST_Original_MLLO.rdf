     xmlns:construct="https://spec.industrialontologies.org/ontology/construct/"
     xmlns:annotation="https://spec.industrialontologies.org/ontology/annotation/">
    <owl:Ontology rdf:about="http://www.semanticweb.org/oliviajungd/ontologies/2026/6/BreastMNIST_Original_MLLO">
        <owl:imports rdf:resource="https://github.com/example/breastmnist-mllo/BreastMNIST_Encoding"/>
        <owl:imports rdf:resource="https://spec.industrialontologies.org/ontology/202601/machinelearninglifecycle/MachineLearningLifecycle/"/>
    </owl:Ontology>
    


    <!-- 
